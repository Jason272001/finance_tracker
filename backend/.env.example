DB_BACKEND=postgres
DATABASE_URL=
# Generate a random 32+ character secret. Never use a sample value in production.
API_TOKEN_SECRET=
STRICT_TOKEN_SECRET=1
# Optional first-admin API setup secret. Leave blank to require the operator CLI.
ADMIN_BOOTSTRAP_SECRET=
ALLOW_DIRECT_PLAN_UPDATES=0
ENABLE_LEGACY_PRECHECKOUT=0
SPECIAL_COUPON_CODE=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=keeperbma
PGUSER=postgres
PGPASSWORD=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_REGULAR=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PREMIUM_PLUS=
STRIPE_PRICE_PREMIUM_PLUS_WEBSITE=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_REGULAR_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_PLUS_WEBSITE_ANNUAL=
BILLING_SUCCESS_URL=https://keeperbma.com/settings.html?billing=success
BILLING_CANCEL_URL=https://keeperbma.com/settings.html?billing=cancel
BILLING_RETURN_URL=https://keeperbma.com/settings.html
REFUND_FULL_WINDOW_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
# HTTPS delivery option for hosts that block SMTP ports (requires a verified sender).
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
